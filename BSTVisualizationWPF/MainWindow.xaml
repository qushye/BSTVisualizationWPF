<Window x:Class="BSTVisualizationWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BSTVisualizationWPF"
        Title="Визуализация бинарного дерева поиска (BST)" 
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3B82F6" Offset="0.0" />
            <GradientStop Color="#1E3A8A" Offset="1.0" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="WhiteTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="NoticeCardBrush" Color="#FFFFEE" />
        <SolidColorBrush x:Key="ListBgBrush" Color="#F4FFF4" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#CCCCCC" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                Background="#F1F5F9" 
                                BorderBrush="#94A3B8" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.RunCommand}" Executed="RunCommand_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.PrevCommand}" Executed="PrevCommand_Executed" CanExecute="PrevCommand_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.NextCommand}" Executed="NextCommand_Executed" CanExecute="NextCommand_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.AboutCommand}" Executed="AboutCommand_Executed" />
        <CommandBinding Command="ApplicationCommands.Close" Executed="ExitCommand_Executed" />
    </Window.CommandBindings>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="8,4">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Выход" Command="ApplicationCommands.Close" />
            </MenuItem>
            <MenuItem Header="_Справка">
                <MenuItem Header="_Описание алгоритма" Command="{x:Static local:MainWindow.AboutCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#EBEBEB" Padding="8,4">
            <StatusBarItem>
                <TextBlock x:Name="tbStatus" Text="Готов к работе" FontSize="11" Foreground="#444444" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="tbStepInfo" Text="Шаг: —" FontSize="11" FontWeight="Bold" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Параметры алгоритма" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12" />

                    <TextBlock Text="Элементы дерева:" Margin="0,4,0,2" />
                    <TextBox x:Name="txtElements" Text="50, 30, 70, 20, 40, 60, 80" Padding="6,4" Margin="0,0,0,8" />

                    <TextBlock Text="Быстрый выбор пресета:" FontSize="10" Foreground="#666666" Margin="0,0,0,4" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Простой" Click="PresetSimple_Click" Padding="8,2" Margin="0,0,4,4" />
                        <Button Content="Сбалансированный" Click="PresetBalanced_Click" Padding="8,2" Margin="0,0,4,4" />
                        <Button Content="Вырожденный" Click="PresetDegenerate_Click" Padding="8,2" Margin="0,0,4,4" />
                    </WrapPanel>

                    <TextBlock Text="Значение для удаления:" Margin="0,4,0,2" />
                    <TextBox x:Name="txtDeleteValue" Text="30" Padding="6,4" Margin="0,0,0,8" />

                    <TextBlock Text="Тип обхода дерева:" Margin="0,4,0,2" />
                    <ComboBox x:Name="cmbTraversal" Margin="0,0,0,12" SelectedIndex="0" Padding="6,4">
                        <ComboBoxItem Content="Симметричный (LNR)" />
                        <ComboBoxItem Content="Прямой (NLR)" />
                        <ComboBoxItem Content="Обратный (LRN)" />
                    </ComboBox>

                    <Button Content="Запустить визуализацию" 
                            Command="{x:Static local:MainWindow.RunCommand}"
                            Background="{StaticResource PrimaryGradientBrush}"
                            Foreground="{StaticResource WhiteTextBrush}"
                            FontWeight="Bold" Padding="12,8" Margin="0,0,0,12" 
                            HorizontalAlignment="Stretch" />

                    <Separator Margin="0,0,0,12" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Результат обхода:" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ListBox Grid.Row="1" x:Name="lstTraversal" 
                             Background="{StaticResource ListBgBrush}" 
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" Background="#E0E0E0" Margin="6,0" Cursor="SizeWE" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="180" />
                    <RowDefinition Height="1*" MinHeight="100" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="{StaticResource BorderLightBrush}" 
                        BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="50" Height="50" HorizontalAlignment="Center">
                            <Ellipse Fill="#E8F5E9" Stroke="#2E7D32" StrokeThickness="2" />
                            <TextBlock Text="50" FontWeight="Bold" FontSize="14" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="txtCanvasPlaceholder" 
                                   Text="Пример узла: Корень (Root)" Margin="0,8,0,0" 
                                   Foreground="#777777" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Описание текущего шага:" FontWeight="SemiBold" Margin="0,0,0,4" />

                    <Border Grid.Row="1" Background="{StaticResource NoticeCardBrush}" 
                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="txtStepDescription" 
                                       Text="Нажмите «Запустить визуализацию» для начала демонстрации." 
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,8,0,0">
                        <Button Content="◄ Назад" 
                                Style="{StaticResource NavButtonStyle}"
                                Command="{x:Static local:MainWindow.PrevCommand}" 
                                Margin="0,0,4,0" />

                        <Button Content="Вперёд ►" 
                                Style="{StaticResource NavButtonStyle}"
                                Command="{x:Static local:MainWindow.NextCommand}" 
                                Margin="4,0,0,0" />
                    </UniformGrid>
                </Grid>

            </Grid>
        </Grid>
    </DockPanel>
</Window>